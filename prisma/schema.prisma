generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Brand {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rackets   Racket[]
}

model Racket {
  id            String          @id @default(cuid())
  externalKey   String          @unique
  slug          String          @unique
  brandId       String
  model         String
  fullName      String
  season        Int
  shape         String
  skillLevel    String
  playStyle     String
  hardness      String
  weightG       Int
  balance       String
  sweetSpot     String
  faceMaterial  String
  frameMaterial String
  coreMaterial  String
  verdict       String
  whoItFits     String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  brand         Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  pros          RacketPro[]
  cons          RacketCon[]
  offers        Offer[]
}

model RacketPro {
  id        String   @id @default(cuid())
  racketId  String
  position  Int
  text      String
  racket    Racket   @relation(fields: [racketId], references: [id], onDelete: Cascade)
}

model RacketCon {
  id        String   @id @default(cuid())
  racketId  String
  position  Int
  text      String
  racket    Racket   @relation(fields: [racketId], references: [id], onDelete: Cascade)
}

model Merchant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  offers    Offer[]
}

model Offer {
  id          String   @id @default(cuid())
  racketId    String
  merchantId  String
  productUrl  String
  currency    String
  priceAmount Decimal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  racket      Racket   @relation(fields: [racketId], references: [id], onDelete: Cascade)
}

model Lead {
  id         String   @id @default(cuid())
  name       String
  contact    String
  intent     String
  notes      String?
  selectedId String?
  compareIds String?
  createdAt  DateTime @default(now())
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  type       String
  page       String?
  racketId   String?
  compareIds String?
  meta       String?
  createdAt  DateTime @default(now())
}
