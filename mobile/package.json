{
  "name": "padelcompare-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.8",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.7",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "doctor": "npx expo-doctor@latest",
    "export": "npm run export:android",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "build:android:preview": "npx eas-cli@latest build --platform android --profile preview",
    "build:android:prod": "npx eas-cli@latest build --platform android --profile production",
    "submit:android:internal": "npx eas-cli@latest submit --platform android --profile internal --latest",
    "submit:android:production": "npx eas-cli@latest submit --platform android --profile production --latest",
    "build:ios:prod": "npx eas-cli@latest build --platform ios --profile production",
    "build:ios:submit": "npx eas-cli@latest build --platform ios --profile production --auto-submit",
    "submit:ios": "npx eas-cli@latest submit --platform ios --profile production --latest"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.5",
    "uuid": "11.1.1"
  },
  "private": true
}
